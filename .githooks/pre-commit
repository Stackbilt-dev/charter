#!/usr/bin/env bash
set -euo pipefail

echo '[pre-commit] Running TypeScript check (pnpm exec tsc --noEmit)...'
pnpm exec tsc --noEmit

# Vendor file auto-tidy (#320): tidy only the staged vendor files, then re-stage only the files tidy wrote.
# Charter pre-commit vendor tidy: scoped to staged files
# Skip with CHARTER_SKIP_TIDY=1
if [ "${CHARTER_SKIP_TIDY:-0}" != "1" ] && [ -f ".ai/manifest.adf" ]; then
  VENDOR_FILES="CLAUDE.md .cursorrules AGENTS.md agents.md GEMINI.md copilot-instructions.md"
  STAGED=$(git diff --cached --name-only --diff-filter=d)
  SOURCES=""
  NAMES=""
  for vf in $VENDOR_FILES; do
    if printf '%s\n' "$STAGED" | grep -xF "$vf" >/dev/null; then
      # Fast path: compiled output is never tidied (#319), so a commit staging only
      # compiled files never invokes the CLI.
      if [ -f "$vf" ] && grep -q 'GENERATED by charter adf compile' "$vf"; then
        continue
      fi
      if ! git diff --quiet -- "$vf"; then
        echo "[pre-commit] $vf has unstaged changes; not auto-tidying it. Stage or stash them, or run: charter adf tidy --source $vf"
        continue
      fi
      SOURCES="$SOURCES --source $vf"
      NAMES="$NAMES $vf"
    fi
  done

  if [ -n "$SOURCES" ]; then
    echo "[pre-commit] Checking staged vendor files:$NAMES"
    PLAN=$(node packages/cli/dist/bin.js adf tidy --dry-run --print-paths $SOURCES 2>/dev/null) || { echo "[pre-commit] adf tidy --dry-run failed; skipping auto-tidy."; PLAN=""; }
    if printf '%s\n' "$PLAN" | grep -E '^(vendor|module) ' >/dev/null; then
      BLOCKED=""
      for p in $(printf '%s\n' "$PLAN" | sed -n 's/^module //p'); do
        if ! git diff --quiet -- "$p" || { [ -e "$p" ] && ! git ls-files --error-unmatch -- "$p" >/dev/null 2>&1; }; then
          BLOCKED="$BLOCKED $p"
        fi
      done
      if [ -n "$BLOCKED" ]; then
        echo "[pre-commit] Not auto-tidying: tidy would write into files with unstaged work:$BLOCKED"
        echo "[pre-commit] Stage or stash them and commit again, or run: charter adf tidy$SOURCES"
      else
        echo "[pre-commit] Moving content beyond the thin pointer into .ai/ ..."
        WROTE=$(node packages/cli/dist/bin.js adf tidy --print-paths $SOURCES 2>/dev/null) || { echo "[pre-commit] adf tidy failed; nothing re-staged."; WROTE=""; }
        for line in $(printf '%s\n' "$WROTE" | sed 's/ /:/'); do
          if printf '%s\n' "$PLAN" | sed 's/ /:/' | grep -xF "$line" >/dev/null; then
            git add -- "${line#*:}"
          fi
        done
        echo "[pre-commit] Vendor files tidied; re-staged only the files tidy wrote."
      fi
    else
      echo "[pre-commit] Vendor config files are clean."
    fi
  fi
fi

# ADF evidence gate: check LOC ceilings if manifest exists
if [ -f ".ai/manifest.adf" ]; then
  echo '[pre-commit] Running ADF evidence check (LOC ceilings)...'
  node packages/cli/dist/bin.js adf evidence --auto-measure --ci 2>/dev/null || {
    echo ''
    echo '[pre-commit] ADF evidence FAILED — LOC ceiling breached.'
    echo '  Run: node packages/cli/dist/bin.js adf evidence --auto-measure'
    echo '  to see which files exceed their ceilings.'
    exit 1
  }
fi
