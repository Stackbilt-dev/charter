Output examples/context-routing-benchmark/charter-context-routing.gif

Set Shell "bash"
Set FontSize 22
Set Width 1200
Set Height 675
Set TypingSpeed 35ms
Set Theme { "name": "Charter", "black": "#0B1020", "red": "#FF6B6B", "green": "#8BD450", "yellow": "#F7C948", "blue": "#5F7FFF", "magenta": "#B794F4", "cyan": "#63D8E3", "white": "#F7F9FC", "brightBlack": "#536079", "brightRed": "#FF8787", "brightGreen": "#A9E66E", "brightYellow": "#FFE082", "brightBlue": "#82A0FF", "brightMagenta": "#D0B6FF", "brightCyan": "#8DE8EF", "brightWhite": "#FFFFFF", "background": "#0B1020", "foreground": "#F7F9FC", "selection": "#263458", "cursor": "#63D8E3" }

Hide
Type "clear"
Enter
Show

Type "pnpm run benchmark:context"
Sleep 500ms
Enter
Sleep 5s
